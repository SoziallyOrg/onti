# --- App ---
# Public URL the app is served from. In dev: http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Random 32+ char secret used to sign session cookies.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=AFeCvVNAndvbUu/emzqRqzoz+1Fb/AGw28BVJJLXz8w=

# --- Database ---
# Local dev: matches docker-compose.dev.yml (pnpm db:up).
DATABASE_URL=postgresql://onti:onti@localhost:5432/onti?schema=public

# --- Initial admin ---
# Used by the seed script (pnpm db:seed) to create the owner's account.
# Required on first boot in production. Once the admin exists, password
# is managed inside the app and these env vars become advisory only.
ADMIN_EMAIL=admin@onti.be
ADMIN_PASSWORD=admin123456
ADMIN_NAME="Onti Banden"

# --- Photos ---
# Where uploaded photos are written. In dev a local folder is fine; in
# production this is a Docker volume mount.
PHOTOS_DIR=./photos

# --- Backups (added in PR #6, deployment only) ---
# AGE_PUBKEY=
# B2_KEY_ID=
# B2_APPLICATION_KEY=
# B2_BUCKET=onti-backups
