# --- App ---
# Public URL the app is served from. In dev: http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Random 32+ char secret used to sign session cookies.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# --- Database (added in PR #2) ---
# DATABASE_URL=postgresql://onti:onti@localhost:5432/onti?schema=public

# --- Initial admin (added in PR #3) ---
# Used by the seed script on first boot to create the owner's account.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME="Onti Banden"

# --- Backups (added in PR #6, deployment only) ---
# AGE_PUBKEY=
# B2_KEY_ID=
# B2_APPLICATION_KEY=
# B2_BUCKET=onti-backups
